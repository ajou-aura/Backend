# AURA Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Database Configuration
# =============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_NAME=aura
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# =============================================================================
# Google OAuth Configuration
# =============================================================================
# You need to create separate OAuth clients for each platform in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Application types:
# - Web: Application type = "Web application"
# - Android: Application type = "Android" (requires package name + SHA-1)
# - iOS: Application type = "iOS" (requires bundle ID)

# Web OAuth (for browser-based authentication)
# Used when mode=web
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
GOOGLE_WEB_REDIRECT_URI=http://localhost:8080/api/auth/callback

# Android OAuth (for React Native Android app)
# Used when mode=android or mode=app
# Create at: Google Cloud Console > Credentials > Create Credentials > OAuth client ID > Android
# Package name: kr.ai.code0.aura
# SHA-1: Get from `cd android && ./gradlew signingReport`
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_SECRET=your-android-client-secret
# Note: Android redirect URI is hardcoded to aura://oauth-callback

# iOS OAuth (for React Native iOS app)
# Used when mode=ios
# Create at: Google Cloud Console > Credentials > Create Credentials > OAuth client ID > iOS
# Bundle ID: kr.ai.code0.aura
# Optional: If not set, will fallback to Android credentials
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_SECRET=your-ios-client-secret
# Note: iOS redirect URI is hardcoded to aura://oauth-callback

# Legacy (backward compatibility) - will be used as fallback if platform-specific vars not set
GOOGLE_CLIENT_ID=${GOOGLE_WEB_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_WEB_CLIENT_SECRET}
GOOGLE_REDIRECT_URI=${GOOGLE_WEB_REDIRECT_URI}

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=your-jwt-secret-key-here-should-be-at-least-256-bits

# =============================================================================
# CORS & Frontend Configuration
# =============================================================================
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# =============================================================================
# Admin Configuration
# =============================================================================
APP_ADMIN_EMAILS=admin@ajou.ac.kr

# =============================================================================
# Firebase Configuration (for push notifications)
# =============================================================================
# Base64 encoded Firebase service account JSON
FIREBASE_KEY=your-base64-encoded-firebase-service-account

# =============================================================================
# Logging Configuration
# =============================================================================
LOGGING_LEVEL=INFO

# =============================================================================
# Database Migration
# =============================================================================
DDL_AUTO=update
SHOW_SQL=false

# =============================================================================
# Notice URLs (scraping targets)
# =============================================================================
NOTICE_GENERAL=https://www.ajou.ac.kr/kr/ajou/notice.do
NOTICE_SCHOLARSHIP=https://www.ajou.ac.kr/kr/ajou/scholarship.do
NOTICE_DORMITORY=https://www.ajou.ac.kr/kr/ajou/dormitory.do

# Department notice URLs (if applicable)
NOTICE_DEPARTMENT_MEDIA=https://media.ajou.ac.kr/notice
NOTICE_DEPARTMENT_SOFTWARE=https://software.ajou.ac.kr/notice
# ... add other department URLs as needed

# =============================================================================
# Feature Flags
# =============================================================================
APP_NOTICE_FORCE_BACKFILL=false
RETAG=false
